NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
# Comma-separated origins permitted to call the API. Add the LAN web URL when testing on a phone.
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://zenval:zenval@localhost:5432/zenval
# Web data source: "mock" (in-browser sample data, default) or "http" (calls NEXT_PUBLIC_API_BASE_URL).
NEXT_PUBLIC_API_MODE=mock
# Simulated latency for the mock adapter, in milliseconds.
NEXT_PUBLIC_API_MOCK_LATENCY_MS=350
